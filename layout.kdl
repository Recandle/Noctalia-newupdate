layout {
    gaps 16
    always-center-single-column
    center-focused-column "never"

    background-color "transparent"

    // Hilangkan garis/border biru window aktif
    focus-ring {
        off
    }

    border {
        off
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    struts {}
}