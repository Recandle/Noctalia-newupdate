{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "/home/sannur/Downloads/logo1.png",
        "width": 22,
        "height": 10,

        "padding": {
            "top": 2,
            "left": 5,
            "bottom": 1
        }
    },

    "display": {
        "separator": " "
    },

    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom",
            "keyColor": "white"
        },

        {
            "key": "│  user    │",
            "type": "custom",
            "format": "oliveaniss",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│ 󰇅 hname   │",
            "type": "custom",
            "format": "oliveaniss",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│ 󰅐 uptime  │",
            "type": "uptime",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│  distro  │",
            "type": "custom",
            "format": "NixOS",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│  kernel  │",
            "type": "command",
            "text": "echo Linux 6.15.3",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│  wm      │",
            "type": "wm",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│  term    │",
            "type": "terminal",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│  shell   │",
            "type": "shell",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│ 󰍛 cpu     │",
            "type": "cpu",
            "format": "Intel® Core™ Ultra 7 258V/265U/268V",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│ 󰉉 disk    │",
            "type": "command",
            "text": "echo '10.20 GiB / 2.00 TiB (0%)'",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "│  memory  │",
            "type": "command",
            "text": "echo '3.75 GiB / 64.00 GiB'",
            "keyColor": "white",
            "outputColor": "white"
        },

        {
            "key": "╰───────────╯",
            "type": "custom",
            "keyColor": "white"
        }
    ]
}